# Dockerfile
FROM ubuntu:24.04

RUN apt-get update && apt-get install -y \
    python3.11 \
    python3.11-dev \
    python3.11-venv \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Create venv
RUN python3.11 -m venv /opt/quantum_env
ENV PATH="/opt/quantum_env/bin:$PATH"

# Install exact compatible versions (TFQ 0.7.x series as of Feb 2026)
RUN pip install --upgrade pip
RUN pip install tensorflow==2.16.2
RUN pip install tensorflow-quantum
RUN pip install pillow scikit-learn matplotlib

WORKDIR /app
COPY quantum_binary_classifier.py /app/

CMD ["python", "quantum_binary_classifier.py", "--help"]

